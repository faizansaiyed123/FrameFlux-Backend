# FrameFlux local/development configuration.
# Replace secrets and service hosts for your deployment.

APP_NAME=FrameFlux API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+asyncpg://frameflux:frameflux@localhost:5432/frameflux
REDIS_URL=redis://localhost:6379/0

APP_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000
STORAGE_BASE_URL=http://localhost:8000
TRUST_PROXY_HEADERS=false

UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
TEMP_DIR=storage/temp

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

MAX_UPLOAD_SIZE_BYTES=524288000
MAX_CHUNK_SIZE_BYTES=52428800

WORKER_JOB_TIMEOUT=3600
WORKER_MAX_JOBS=4

MAX_VIDEO_DURATION_SECONDS=7200
MAX_VIDEO_RESOLUTION=3840
MAX_CONCURRENT_JOBS_PER_USER=10

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=15

# Generate a production secret with a cryptographically secure generator.
# Never commit a real .env file or production secrets to Git.
