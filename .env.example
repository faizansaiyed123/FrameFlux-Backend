# FrameFlux backend configuration example.
# Copy to .env for local/container use and replace every placeholder marked CHANGE_ME.
# For production, provide secrets through your deployment secret manager.

APP_NAME=FrameFlux API
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false

DATABASE_URL=postgresql+asyncpg://frameflux:CHANGE_ME@postgres:5432/frameflux
REDIS_URL=redis://redis:6379/0

APP_ORIGIN=https://app.example.com
API_BASE_URL=https://api.example.com
STORAGE_BASE_URL=https://api.example.com
TRUST_PROXY_HEADERS=true

UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
TEMP_DIR=storage/temp

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

MAX_UPLOAD_SIZE_BYTES=524288000
MAX_CHUNK_SIZE_BYTES=52428800

WORKER_JOB_TIMEOUT=3600
WORKER_MAX_JOBS=4

MAX_VIDEO_DURATION_SECONDS=7200
MAX_VIDEO_RESOLUTION=3840
MAX_CONCURRENT_JOBS_PER_USER=10

JWT_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=15

POSTGRES_DB=frameflux
POSTGRES_USER=frameflux
POSTGRES_PASSWORD=CHANGE_ME
