APP_NAME=FrameFlux API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Postgres connection string (async driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/frameflux

# Redis connection string (used for background jobs, rate limiting, progress tracking)
REDIS_URL=redis://localhost:6379/0

# Frontend origin allowed by CORS
APP_ORIGIN=http://localhost:3000

# This API's own public base URL (used to build share/embed links)
API_BASE_URL=http://localhost:8000

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Upload / storage limits (bytes)
MAX_UPLOAD_SIZE_BYTES=524288000
MAX_CHUNK_SIZE_BYTES=52428800

UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
TEMP_DIR=storage/temp

# Background worker limits
WORKER_JOB_TIMEOUT=3600
WORKER_MAX_JOBS=4

# Resource limits
MAX_VIDEO_DURATION_SECONDS=7200
MAX_VIDEO_RESOLUTION=3840
MAX_CONCURRENT_JOBS_PER_USER=10

# Auth / JWT settings
# REQUIRED - the app will fail to start without this set. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=15
